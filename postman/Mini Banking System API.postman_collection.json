{
  "info": {
    "name": "Mini Banking System API",
    "description": "Authentication, banking, transfer, filtered history, and administrator requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "fullName", "value": "Ada Lovelace" },
    { "key": "email", "value": "ada@example.com" },
    { "key": "phoneNumber", "value": "+255712345678" },
    { "key": "password", "value": "StrongPass123!" },
    { "key": "amount", "value": "1000.00" },
    { "key": "accessToken", "value": "" },
    { "key": "recipientAccountNumber", "value": "2026000002" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 200) {",
            "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "View Account",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/account"
      }
    },
    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {{amount}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/account/deposit"
      }
    },
    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {{amount}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/account/withdraw"
      }
    },
    {
      "name": "Transfer",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientAccountNumber\": \"{{recipientAccountNumber}}\",\n  \"amount\": {{amount}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/account/transfer"
      }
    },
    {
      "name": "Transaction History",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/account/transactions?page=0&size=10&type=DEPOSIT&from=2026-10-01T00:00:00Z&to=2026-10-31T23:59:59Z"
      }
    },
    {
      "name": "Admin - List Users",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/admin/users?page=0&size=20"
      }
    },
    {
      "name": "Admin - List Accounts",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/admin/accounts?page=0&size=20"
      }
    }
  ]
}
